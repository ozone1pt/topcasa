APP_NAME=TopCasa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Document root real. Sem isto, `php artisan` no staging resolve o disco
# `public` para a pasta de produção (o index.php do staging chama
# usePublicPath, mas o CLI não passa por ele). Em produção deixa vazio.
# APP_PUBLIC_PATH=/home/u855228810/domains/topcasa.pt/public_html/staging

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=topcasa
DB_USERNAME=
DB_PASSWORD=

# Only needed once, to run `php artisan app:migrar-dados-legado` against a
# restored copy of the legacy site's database during the production
# cutover (Fase 12). Leave unset otherwise.
DB_LEGADO_HOST=127.0.0.1
DB_LEGADO_PORT=3306
DB_LEGADO_DATABASE=
DB_LEGADO_USERNAME=
DB_LEGADO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@topcasa.pt"
MAIL_FROM_NAME="${APP_NAME}"

# Tokens da app móvel (Sanctum), em minutos. Vazio = não expiram.
SANCTUM_TOKEN_EXPIRATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GROQ_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
